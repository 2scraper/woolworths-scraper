# woolworths-scraper — copy this to `.env` and fill in what you need.
#
#   cp .env.example .env
#
# Nothing here is required. With no .env at all the scrapers run exactly as
# they do now: a local headful browser on your own address, no key, no proxy.
#
# Why a file and not the command line: a secret in argv is readable by
# anything that can run `ps` and lands in your shell history. Every value
# below is read by `env_config.py`, which also DEFERS to anything already
# exported — a CI secret or a `direnv` setting is never clobbered by this
# file.
#
# Precedence, highest first:
#     explicit CLI flag  >  exported environment variable  >  .env  >  default
#
# Check what was picked up, WITHOUT printing any secrets:
#     python3 env_config.py
#
# Every placeholder in braces below is treated as UNSET. That is deliberate:
# a copied example that reads as configured sends `{login}-zone-…` to the API
# as a username and produces a 401 a long way from its cause.


# --- 2Captcha -------------------------------------------------------------
# One key covers captcha solving, the Scraping Browser API, proxies and
# fingerprints — they are four separately-billed products behind it.
#
# Worth knowing before you buy anything for THIS site: no captcha has been
# observed on woolworths.com.au at all. Its refusal is Akamai's edge denial —
# HTTP 403 and ~400 bytes of plain HTML with no widget of any kind on it — so
# there is nothing on that page for a solver to answer, and this scraper
# never attempts one. The key is still useful here for the two products
# below.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# --- Scraping Browser API (over CDP) --------------------------------------
# A remote browser with a residential exit, which is what gets you past
# Akamai from an address it refuses. Endpoint SHAPE:
#
#   ws://{login}-zone-scraping_browser-country-{cc}-pid-{profileId}:{password}@cb.2captcha.com:9222
#
# `country-` picks the exit country and `pid-` is a profile with persistent
# cookies — ONE live connection each, so reuse profile ids rather than
# minting one per run, and do not raise --concurrency above 1 on this path.
#
# An AUSTRALIAN exit is NOT required for this site: a US exit was served the
# full catalogue normally on 2026-09-16. Measured, not assumed.
#
# Deliberately no working endpoint is pasted here or anywhere else in this
# repo: a profile's credentials expire in about a day, so a pasted one would
# be stale before you read it and would fail with an auth error a long way
# from its cause. Get fresh credentials from your 2Captcha dashboard.
WOOLWORTHS_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-au-pid-{profileId}:{password}@cb.2captcha.com:9222

# --- Proxy ----------------------------------------------------------------
# A residential exit for a locally-launched browser. Credentials are passed
# through the driver's own fields, never onto the browser's command line.
#
#   http://{user}:{password}@au.proxy.2captcha.com:2334
#
# Note the Selenium engine CANNOT authenticate a proxy — chromedriver's
# --proxy-server takes an address with nowhere to put a password. It strips
# the credentials and warns. Use the Playwright or pyppeteer engine instead.
WOOLWORTHS_PROXY=http://{user}:{password}@au.proxy.2captcha.com:2334

# --- Default target -------------------------------------------------------
# Saves typing --url. A search or a category:
#
#   https://www.woolworths.com.au/shop/search/products?searchTerm=milk
#   https://www.woolworths.com.au/shop/browse/bakery
#
# Not a credential, so this one is usable as written.
WOOLWORTHS_URL=https://www.woolworths.com.au/shop/search/products?searchTerm=milk
